<?xml version="1.0" encoding="utf-8"?>
<!-- A solid #050505 fill used as the Android 12+ system-splash icon. It matches
     @color/splash_bg exactly, so the OS's mandatory splash renders as a plain
     dark screen with no visible launcher icon — it dissolves straight into the
     Flutter SEC7OR animation instead of showing an icon-on-a-circle step first. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/splash_bg" />
</shape>
