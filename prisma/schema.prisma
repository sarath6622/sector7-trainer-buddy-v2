generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  BRANCH_ADMIN
  TRAINER
  KICKBOXING_TRAINER
  CROSSFIT_TRAINER
  CLIENT
  TV_DISPLAY
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  FULL_DAY
  HALF_DAY_AM
  HALF_DAY_PM
  CUSTOM
}

enum LeaveCategory {
  REGULAR
  EMERGENCY
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum AttendanceStatus {
  PRESENT
  NO_SHOW
  UNAVAILABLE
}

enum NotificationChannel {
  WHATSAPP
  IN_APP
  BOTH
}

enum NotificationStatus {
  SENT
  FAILED
  PENDING
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum KickboxingClientType {
  GYM_MEMBER    // PT client — has a ClientProfile in the system
  GYM_ONLY      // Gym member without PT — enrolled by name
  EXTERNAL_ONLY // Not a gym member — walk-in only
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum ExerciseCategory {
  HYPERTROPHY
  CARDIO
  FLEXIBILITY
  STRENGTH
  FUNCTIONAL
}

enum ExerciseType {
  WEIGHTED      // Sets × Reps × Weight kg  (Bench Press, Squat, Deadlift…)
  BODYWEIGHT    // Sets × Reps, no load     (Pull-ups, Push-ups, Lunges…)
  DURATION      // Sets × Time in seconds   (Plank, Wall Sit…)
  CARDIO        // Duration + distance      (Treadmill, Cycling, Rowing…)
}

// Second metric captured alongside duration for CARDIO exercises. The
// workout logger reads this off the Exercise row to label and bind the
// second column. Non-CARDIO exercises always store KM (the default) but
// the field is unused on render.
enum SecondaryMetric {
  KM        // Distance in km, stored in WorkoutSet.notes (legacy)
  STEPS     // Integer count, stored in WorkoutSet.stepsCount (Stair Climber, etc.)
  METERS    // Distance in m, stored in WorkoutSet.notes
  NONE      // Only duration is captured; second column hidden
}

enum BadgeType {
  STREAK             // Consecutive session attendance
  PERSONAL_RECORD    // New max weight on an exercise
  BODY_COMPOSITION   // Weight loss / body fat reduction milestones
  SESSION_MILESTONE  // Total sessions completed
  WEIGHT_LIFTED      // Absolute weight threshold on a specific exercise (kept for backward compat)
  EXERCISE_MILESTONE // Threshold on exercise: weight (kg), reps, or duration (sec)
}

enum ThresholdUnit {
  KG        // Weight in kilograms (weighted exercises)
  REPS      // Repetitions (bodyweight exercises)
  SECONDS   // Duration in seconds (duration exercises)
  STEPS     // Step count (CARDIO with secondaryMetric=STEPS, e.g. Stair Climber)
}

enum DurationCondition {
  LONGER_IS_BETTER  // e.g. plank hold — longer = better
  SHORTER_IS_BETTER // e.g. sprint — shorter = better
}

enum Gender {
  MALE
  FEMALE
}

enum GenderFilter {
  MALE
  FEMALE
  ALL
}

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KickboxingSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum CrossfitSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum SwapStatus {
  PENDING
  APPROVED
  CANCELLED
}

// ─── BRANCH ──────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                User[]
  trainerProfiles      TrainerProfile[]
  clientProfiles       ClientProfile[]
  ptPackages           PtPackage[]
  ptPackagePlans       PtPackagePlan[]
  sessionSchedules     SessionSchedule[]
  sessionInstances     SessionInstance[]
  leaveRequests        LeaveRequest[]
  clientUnavailability         ClientUnavailability[]
  trainerReassignments         TrainerReassignment[]
  trainerAvailabilityOverrides TrainerAvailabilityOverride[]
  trainerShifts        TrainerShift[]
  shiftSwaps           ShiftSwap[]
  kickboxingClasses     KickboxingClass[]
  kickboxingEnrollments KickboxingEnrollment[]
  kickboxingSessions    KickboxingSession[]
  kickboxingAttendances KickboxingAttendance[]
  crossfitClasses       CrossfitClass[]
  crossfitClassTrainers CrossfitClassTrainer[]
  crossfitEnrollments   CrossfitEnrollment[]
  crossfitSessions      CrossfitSession[]
  crossfitAttendances   CrossfitAttendance[]
  paymentRecords       PaymentRecord[]
  notificationLogs     NotificationLog[]
  restTimers           RestTimer[]
  auditLogs            AuditLog[]
  branchSettings       BranchSettings?
  userBadges           UserBadge[]
  communityPosts       CommunityPost[]
  rescheduleRequests   RescheduleRequest[]
  tvDevices            TvDevice[]
  tvControlState       TvControlState?
  tvAnnouncements      TvAnnouncement[]
  tvEvents             TvEvent[]

  @@map("branches")
}

// ─── BRANCH SETTINGS ─────────────────────────────────

model BranchSettings {
  id                        String  @id @default(cuid())
  branchId                  String  @unique
  defaultSessionDurationMin Int     @default(60)
  carryForwardLimit         Int     @default(3)
  cancellationPolicyEnabled Boolean @default(false)
  cancellationWindowMin     Int     @default(120)
  reminderTimingMin         Int     @default(60)
  noShowThresholdMin        Int     @default(15)
  kickboxingClassSizeLimit  Int     @default(20)
  monthlyRegularLeaveQuota  Int     @default(4)
  monthlyEmergencyLeaveQuota Int    @default(1)
  // Days a client can go without a logged body/weight measurement before
  // trainer + admin client lists flag them with a "No measurements" badge.
  measurementReminderDays   Int     @default(30)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("branch_settings")
}

// ─── USER ────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  branchId       String
  email          String    @unique
  phone          String?
  passwordHash   String
  firstName      String
  lastName       String
  roles          UserRole[]
  profileImageUrl String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id])
  trainerProfile TrainerProfile?
  clientProfile  ClientProfile?

  // Actions performed by this user
  auditLogsAsActor      AuditLog[]        @relation("AuditActor")
  notificationsReceived NotificationLog[] @relation("NotificationRecipient")
  fcmTokens             FcmToken[]
  shiftSwapRequests     ShiftSwap[]       @relation("SwapRequests")

  @@index([branchId])
  @@index([email])
  @@map("users")
}

// ─── TRAINER PROFILE ─────────────────────────────────

model TrainerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  branchId       String
  specialties    String[]
  certifications String[]
  bio            String?
  workingHoursStart String?
  workingHoursEnd   String?
  workingDays    DayOfWeek[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User   @relation(fields: [userId], references: [id])
  branch   Branch @relation(fields: [branchId], references: [id])

  // Relations
  ptPackages           PtPackage[]
  sessionSchedules     SessionSchedule[]     @relation("ScheduleTrainer")
  sessionInstances     SessionInstance[]      @relation("InstanceTrainer")
  leaveRequests        LeaveRequest[]
  reassignmentsFrom    TrainerReassignment[] @relation("OriginalTrainer")
  reassignmentsTo      TrainerReassignment[] @relation("ReplacementTrainer")
  availabilityOverrides TrainerAvailabilityOverride[]
  shifts               TrainerShift[]
  kickboxingClasses      KickboxingClass[]
  crossfitClassTrainers  CrossfitClassTrainer[]
  swapsAsA               ShiftSwap[]     @relation("SwapAsA")
  swapsAsB             ShiftSwap[]     @relation("SwapAsB")

  @@index([branchId])
  @@map("trainer_profiles")
}

// ─── TRAINER AVAILABILITY OVERRIDE ───────────────────

/// Date-specific overrides to a trainer's default working schedule.
/// Use `isAvailable: true` to add availability on a normally off day (e.g., work this Sunday).
/// Use `isAvailable: false` to remove availability on a normally working day (e.g., off this Monday).
model TrainerAvailabilityOverride {
  id               String   @id @default(cuid())
  branchId         String
  trainerProfileId String
  date             DateTime
  isAvailable      Boolean
  startTime        String?  // Override working hours start (HH:MM), null = use profile default
  endTime          String?  // Override working hours end (HH:MM), null = use profile default
  reason           String?
  createdByUserId  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id])
  trainer TrainerProfile @relation(fields: [trainerProfileId], references: [id])

  @@unique([trainerProfileId, date])
  @@index([branchId, date])
  @@index([trainerProfileId, date])
  @@map("trainer_availability_overrides")
}

// ─── TRAINER SHIFTS ──────────────────────────────────

/// A named time window that represents one shift a trainer works.
/// A trainer can have multiple shifts (e.g. Morning Mon–Wed, Evening Thu–Sat).
/// A session is bookable if its day+time falls within ANY of the trainer's shifts.
/// If a trainer has NO shifts configured, they are treated as all-day available (legacy fallback).
model TrainerShift {
  id               String      @id @default(cuid())
  branchId         String
  trainerProfileId String
  label            String      // e.g. "Morning", "Evening", "Mid-shift"
  startTime        String      // "06:00" — 24hr HH:MM
  endTime          String      // "10:30" — 24hr HH:MM
  days             DayOfWeek[] // days of week this shift applies to
  effectiveFrom    DateTime    @default(now()) // when this shift starts applying
  effectiveUntil   DateTime?                   // null = ongoing; set when replaced by a new shift
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id])
  trainer TrainerProfile @relation(fields: [trainerProfileId], references: [id])

  @@index([branchId, trainerProfileId])
  @@index([trainerProfileId, effectiveFrom]) // for active-shift lookups
  @@map("trainer_shifts")
}

// ─── SHIFT SWAP ──────────────────────────────────────

/// A temporary swap of working windows between two trainers for a date range.
/// Acts as an overlay — availability checks substitute each trainer's shift windows for the other
/// during [swapFrom, swapUntil). Does NOT mutate TrainerShift records.
model ShiftSwap {
  id                String     @id @default(cuid())
  branchId          String
  trainerAProfileId String     // trainer giving up their window
  trainerBProfileId String     // trainer receiving trainer A's window (and vice-versa)
  swapFrom          DateTime   // inclusive start date (UTC midnight)
  swapUntil         DateTime   // exclusive end date (UTC midnight)
  status            SwapStatus @default(PENDING)
  requestedByUserId String
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  branch     Branch         @relation(fields: [branchId], references: [id])
  trainerA   TrainerProfile @relation("SwapAsA", fields: [trainerAProfileId], references: [id])
  trainerB   TrainerProfile @relation("SwapAsB", fields: [trainerBProfileId], references: [id])
  requestedBy User          @relation("SwapRequests", fields: [requestedByUserId], references: [id])

  @@index([branchId, swapFrom])
  @@index([trainerAProfileId, status])
  @@index([trainerBProfileId, status])
  @@map("shift_swaps")
}

// ─── CLIENT PROFILE ──────────────────────────────────

model ClientProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  branchId               String
  dateOfBirth            DateTime?
  gender                 Gender?
  emergencyContactName   String?
  emergencyContactPhone  String?
  height                 Float?
  currentWeight          Float?
  bodyFatPercentage      Float?
  medicalConditions      String?
  fitnessGoals           String?
  sessionDurationOverrideMin Int?
  paymentStatus          PaymentStatus @default(PENDING)
  /// Opt-in flag for the gym TV leaderboard. When false, this client is excluded
  /// from name/photo panels and live PR/badge takeovers, but still contributes
  /// to anonymous aggregates (total volume, attendance counts).
  showOnTv               Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user     User   @relation(fields: [userId], references: [id])
  branch   Branch @relation(fields: [branchId], references: [id])

  // Relations
  ptPackages            PtPackage[]
  sessionSchedules      SessionSchedule[]    @relation("ScheduleClient")
  sessionInstances      SessionInstance[]     @relation("InstanceClient")
  unavailability        ClientUnavailability[]
  progressEntries       ProgressEntry[]
  paymentRecords        PaymentRecord[]
  kickboxingEnrollments  KickboxingEnrollment[]
  kickboxingAttendances  KickboxingAttendance[]
  crossfitEnrollments    CrossfitEnrollment[]
  crossfitAttendances    CrossfitAttendance[]
  userBadges           UserBadge[]
  communityPosts       CommunityPost[]
  communityReactions   CommunityReaction[]
  communityComments    CommunityComment[]
  rescheduleRequests   RescheduleRequest[]

  @@index([branchId])
  @@map("client_profiles")
}

// ─── PT PACKAGE ──────────────────────────────────────

model PtPackage {
  id                String   @id @default(cuid())
  branchId          String
  clientProfileId   String
  trainerProfileId  String
  planId            String?
  sessionsPerMonth  Int
  /// Authoritative total sessions for the full package window
  /// (`startDate` → `endDate`). Auto-computed from plan when planId is set,
  /// admin-editable for one-offs/renewals.
  totalSessions     Int      @default(0)
  /// Backfill for sessions consumed before the app onboarding. Counts toward
  /// `used` in package-window accounting.
  onboardingUsedSessions Int @default(0)
  onboardingNotes   String?
  /// Per-package override of `BranchSettings.carryForwardLimit`. Null = inherit
  /// branch default. Used by the cycle-end cron when rolling unused sessions
  /// into the next package.
  carryForwardLimit Int?
  /// Sessions credited to the next package when this one expired (set by
  /// `processCycleEndsForPackages`). 0 until cycle-end cron has run.
  carryForwardOutSessions Int @default(0)
  /// Set when the cycle-end cron processes this package. Used as the
  /// idempotency guard so re-running the cron is a no-op.
  lastProcessedAt DateTime?
  sessionChargeAmount Float?
  isActive          Boolean  @default(true)
  startDate         DateTime
  endDate           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch   Branch         @relation(fields: [branchId], references: [id])
  client   ClientProfile  @relation(fields: [clientProfileId], references: [id])
  trainer  TrainerProfile @relation(fields: [trainerProfileId], references: [id])
  plan     PtPackagePlan? @relation(fields: [planId], references: [id])

  @@index([branchId, clientProfileId])
  @@index([branchId, trainerProfileId])
  @@index([branchId, planId])
  @@map("pt_packages")
}

// ─── PT PACKAGE PLAN (catalog) ───────────────────────

/// Per-branch catalog of named PT package plans (e.g. "Standard 12 — ₹4000").
/// Admins pick a plan from a dropdown when creating a mapping; values from the
/// plan auto-fill into the mapping form but remain editable per assignment.
/// PtPackage.planId records which plan an assignment came from (nullable for
/// freeform/legacy assignments).
model PtPackagePlan {
  id                  String   @id @default(cuid())
  branchId            String
  name                String
  sessionsPerMonth    Int
  pricePerCycle       Float
  sessionChargeAmount Float?
  /// Duration of one cycle in days. Used by the mapping form to auto-derive
  /// endDate as startDate + durationDays. Common values: 30 (monthly), 60, 90,
  /// 180, 365.
  durationDays        Int      @default(30)
  description         String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  branch   Branch      @relation(fields: [branchId], references: [id])
  packages PtPackage[]

  @@unique([branchId, name])
  @@index([branchId, isActive])
  @@map("pt_package_plans")
}

// ─── SESSION SCHEDULE (recurring template) ───────────

model SessionSchedule {
  id               String    @id @default(cuid())
  branchId         String
  clientProfileId  String
  trainerProfileId String
  dayOfWeek        DayOfWeek
  startTime        String
  durationMin      Int
  isActive         Boolean   @default(true)
  validFrom        DateTime
  validUntil       DateTime?
  createdByUserId  String?   // null = legacy; populated for all new records (admin or trainer)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id])
  client  ClientProfile  @relation("ScheduleClient", fields: [clientProfileId], references: [id])
  trainer TrainerProfile @relation("ScheduleTrainer", fields: [trainerProfileId], references: [id])

  sessionInstances SessionInstance[]

  @@index([branchId, trainerProfileId])
  @@index([branchId, clientProfileId])
  @@map("session_schedules")
}

// ─── SESSION INSTANCE (single occurrence) ────────────

model SessionInstance {
  id               String        @id @default(cuid())
  branchId         String
  scheduleId       String?
  clientProfileId  String
  trainerProfileId String
  scheduledDate    DateTime
  scheduledTime    String
  durationMin      Int
  status           SessionStatus @default(SCHEDULED)
  startedAt        DateTime?
  endedAt          DateTime?
  actualDurationMin Int?
  startedByUserId  String?
  endedByUserId    String?
  // ── Pause tracking (mirrors RestTimer pattern: server-driven, both
  //    trainer and client subscribe via Pusher to stay in sync). When
  //    `pausedAt` is non-null the session clock is currently paused.
  //    `accumulatedPausedSec` is the total time paused across all
  //    cycles, finalized on resume. `pauseUpdatedAt` is a dedicated
  //    monotonic stamp the wire payload uses for guard logic — it
  //    advances ONLY on pause/resume so unrelated row updates don't
  //    spook the client into a re-fetch.
  pausedAt              DateTime?
  accumulatedPausedSec  Int       @default(0)
  pausedByUserId        String?
  pauseUpdatedAt        DateTime?
  noShowMarkedAt   DateTime?
  noShowMarkedByUserId String?
  cancelledAt      DateTime?
  cancelledByUserId String?
  cancellationWithinWindow Boolean?
  isCarryForward   Boolean       @default(false)
  carryForwardFromMonth DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  branch   Branch          @relation(fields: [branchId], references: [id])
  schedule SessionSchedule? @relation(fields: [scheduleId], references: [id])
  client   ClientProfile   @relation("InstanceClient", fields: [clientProfileId], references: [id])
  trainer  TrainerProfile  @relation("InstanceTrainer", fields: [trainerProfileId], references: [id])

  workoutLogs          WorkoutLog[]
  trainerReassignment  TrainerReassignment?
  rescheduleRequests   RescheduleRequest[]
  restTimer            RestTimer?

  @@index([branchId, scheduledDate])
  @@index([branchId, clientProfileId, scheduledDate])
  @@index([branchId, trainerProfileId, scheduledDate])
  @@index([status])
  @@map("session_instances")
}

// ─── WORKOUT LOG ─────────────────────────────────────

model WorkoutLog {
  id                String   @id @default(cuid())
  sessionInstanceId String
  exerciseId        String
  orderIndex        Int
  // ADR-037 (2026-05-16): mark-complete flag. Either the trainer or the
  // client taps "Mark complete" on the WorkoutLogger card. Completed logs
  // sort to the bottom of the list (UI), collapsed by default, with a
  // strikethrough header. Can be unmarked. `completedAt` is the
  // most-recent transition into completed; null when isCompleted=false.
  isCompleted       Boolean  @default(false)
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessionInstance SessionInstance @relation(fields: [sessionInstanceId], references: [id])
  exercise        Exercise        @relation(fields: [exerciseId], references: [id])

  sets WorkoutSet[]

  @@index([sessionInstanceId])
  @@map("workout_logs")
}

model WorkoutSet {
  id           String  @id @default(cuid())
  workoutLogId String
  setNumber    Int
  reps         Int?
  weightKg     Float?
  durationSec  Int?
  rpe          Int?
  // Rest taken before this set, in seconds. Captured from the rest timer's
  // `total` (auto-filled when the trainer adds a set right after a rest
  // finishes) or entered manually. Null = no rest data recorded.
  restSec      Int?
  // Step count for CARDIO exercises whose Exercise.secondaryMetric = STEPS
  // (e.g. Stair Climber). For KM/METERS the distance still lives in `notes`
  // for now.
  stepsCount   Int?
  notes        String?
  createdAt    DateTime @default(now())

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id])

  @@index([workoutLogId])
  @@map("workout_sets")
}

// ─── REST TIMER ─────────────────────────────────────
// One ephemeral row per active session. Trainer drives mutations; both
// trainer and client read it so the countdown stays in sync across devices.
// Rows are deleted on Stop and have no native TTL — a periodic cleanup job
// (or `WHERE updatedAt < now() - 1 day`) handles forgotten rows. Total cap
// of totalSec ≤ 3600 is enforced by the API validator.

model RestTimer {
  sessionInstanceId  String   @id
  branchId           String
  endTime            DateTime?  // null when paused; otherwise countdown target
  pausedRemainingSec Int?       // null when running; otherwise frozen seconds
  totalSec           Int
  startedByUserId    String     // who last issued a write — for audit fan-out
  updatedAt          DateTime   @updatedAt

  sessionInstance SessionInstance @relation(fields: [sessionInstanceId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id])

  @@index([branchId, updatedAt])
  @@map("rest_timers")
}

// ─── EXERCISE LIBRARY (global) ───────────────────────

model Exercise {
  id                  String           @id @default(cuid())
  name                String
  targetMuscleGroup   String
  secondaryMuscles    String[]
  equipmentRequired   String?
  difficulty          DifficultyLevel?
  category            ExerciseCategory
  exerciseType        ExerciseType     @default(WEIGHTED)
  // For CARDIO exercises: which second metric the workout logger should
  // capture alongside duration. KM is the default (legacy behavior, value
  // stored in WorkoutSet.notes); STEPS uses the dedicated stepsCount column;
  // METERS reuses notes with a relabeled column; NONE hides the second
  // column entirely. Ignored for non-CARDIO types.
  secondaryMetric     SecondaryMetric  @default(KM)
  instructions        String?
  demoVideoUrl        String?
  demoGifUrl          String?
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  isCompound       Boolean          @default(false)

  workoutLogs      WorkoutLog[]
  badgeDefinitions BadgeDefinition[]
  communityPosts   CommunityPost[]

  @@index([targetMuscleGroup])
  @@index([category])
  @@map("exercises")
}

// ─── PROGRESS TRACKING ───────────────────────────────

model ProgressEntry {
  id              String   @id @default(cuid())
  clientProfileId String
  recordedAt      DateTime @default(now())
  recordedByUserId String
  weightKg        Float?
  bodyFatPercent   Float?
  muscleMass       Float?
  chest            Float?
  waist            Float?
  hips             Float?
  bicepLeft        Float?
  bicepRight       Float?
  thighLeft        Float?
  thighRight       Float?
  photoUrls        String[]
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client ClientProfile @relation(fields: [clientProfileId], references: [id])

  @@index([clientProfileId, recordedAt])
  @@map("progress_entries")
}

// ─── LEAVE MANAGEMENT ────────────────────────────────

model LeaveRequest {
  id               String      @id @default(cuid())
  branchId         String
  trainerProfileId String
  startDate        DateTime
  endDate          DateTime
  leaveType        LeaveType      @default(FULL_DAY)
  leaveCategory    LeaveCategory  @default(REGULAR)
  startTime        String?        // HH:MM — null for FULL_DAY
  endTime          String?        // HH:MM — null for FULL_DAY
  reason           String?
  status           LeaveStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id])
  trainer TrainerProfile @relation(fields: [trainerProfileId], references: [id])

  @@index([branchId, trainerProfileId])
  @@index([branchId, status])
  @@map("leave_requests")
}

model ClientUnavailability {
  id              String   @id @default(cuid())
  branchId        String
  clientProfileId String
  date            DateTime
  reason          String?
  createdAt       DateTime @default(now())

  branch Branch        @relation(fields: [branchId], references: [id])
  client ClientProfile @relation(fields: [clientProfileId], references: [id])

  @@unique([clientProfileId, date])
  @@index([branchId, date])
  @@map("client_unavailability")
}

// ─── TRAINER REASSIGNMENT ────────────────────────────

model TrainerReassignment {
  id                          String   @id @default(cuid())
  branchId                    String
  sessionInstanceId           String   @unique
  originalTrainerProfileId    String
  replacementTrainerProfileId String
  reassignedByUserId          String
  reason                      String?
  createdAt                   DateTime @default(now())

  branch             Branch          @relation(fields: [branchId], references: [id])
  sessionInstance    SessionInstance @relation(fields: [sessionInstanceId], references: [id])
  originalTrainer    TrainerProfile  @relation("OriginalTrainer", fields: [originalTrainerProfileId], references: [id])
  replacementTrainer TrainerProfile  @relation("ReplacementTrainer", fields: [replacementTrainerProfileId], references: [id])

  @@index([branchId])
  @@map("trainer_reassignments")
}

// ─── RESCHEDULE REQUESTS ─────────────────────────────────

/// A client-initiated request to move a specific session to a new date/time.
/// Reviewed and actioned by admin or the assigned trainer.
/// One PENDING request is allowed per session at a time (enforced in service layer).
model RescheduleRequest {
  id                String           @id @default(cuid())
  branchId          String
  sessionInstanceId String           // the session the client wants to move
  clientProfileId   String           // the client making the request
  requestedDate     DateTime         // proposed new date (date portion only used)
  requestedTime     String           // proposed new time "HH:MM" (24hr)
  reason            String?
  status            RescheduleStatus @default(PENDING)
  reviewedByUserId  String?          // admin or trainer who actioned this
  reviewedAt        DateTime?
  reviewNotes       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  branch          Branch          @relation(fields: [branchId], references: [id])
  sessionInstance SessionInstance @relation(fields: [sessionInstanceId], references: [id])
  client          ClientProfile   @relation(fields: [clientProfileId], references: [id])

  @@index([branchId, status])
  @@index([branchId, clientProfileId])
  @@index([sessionInstanceId])
  @@map("reschedule_requests")
}

// ─── KICKBOXING ──────────────────────────────────────

model KickboxingClass {
  id               String    @id @default(cuid())
  branchId         String
  trainerProfileId String
  name             String    // e.g. "Monday 6PM Kickboxing", "Beginner KB"
  dayOfWeek        DayOfWeek
  startTime        String    // "18:00"
  durationMin      Int       @default(60)
  maxCapacity      Int       @default(20)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id])
  trainer TrainerProfile @relation(fields: [trainerProfileId], references: [id])

  enrollments KickboxingEnrollment[]
  sessions    KickboxingSession[]

  @@index([branchId])
  @@map("kickboxing_classes")
}

model KickboxingEnrollment {
  id              String              @id @default(cuid())
  branchId        String
  classId         String
  clientProfileId String?
  clientType      KickboxingClientType
  externalName    String?
  externalPhone   String?
  isActive        Boolean             @default(true)
  enrolledAt      DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  branch Branch              @relation(fields: [branchId], references: [id])
  class  KickboxingClass     @relation(fields: [classId], references: [id])
  client ClientProfile?      @relation(fields: [clientProfileId], references: [id])

  @@index([branchId, clientType])
  @@map("kickboxing_enrollments")
}

model KickboxingSession {
  id              String                  @id @default(cuid())
  branchId        String
  classId         String
  date            DateTime                // the specific date of this session occurrence
  status          KickboxingSessionStatus @default(SCHEDULED)
  startedAt       DateTime?
  endedAt         DateTime?
  startedByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  branch      Branch               @relation(fields: [branchId], references: [id])
  class       KickboxingClass      @relation(fields: [classId], references: [id])
  attendances KickboxingAttendance[]

  @@unique([classId, date])
  @@index([branchId, date])
  @@index([branchId, status])
  @@map("kickboxing_sessions")
}

model KickboxingAttendance {
  id              String   @id @default(cuid())
  branchId        String
  sessionId       String
  clientProfileId String?  // null for external/walk-in
  externalName    String?  // for non-enrolled walk-ins
  markedByUserId  String   // kickboxing trainer's user id
  markedAt        DateTime @default(now())

  branch  Branch            @relation(fields: [branchId], references: [id])
  session KickboxingSession @relation(fields: [sessionId], references: [id])
  client  ClientProfile?    @relation(fields: [clientProfileId], references: [id])

  @@unique([sessionId, clientProfileId])
  @@index([branchId, sessionId])
  @@map("kickboxing_attendances")
}

// ─── CROSSFIT ────────────────────────────────────────

model CrossfitClass {
  id          String    @id @default(cuid())
  branchId    String
  name        String    // e.g. "Monday 6AM WOD", "Foundations"
  dayOfWeek   DayOfWeek
  startTime   String    // "06:00"
  durationMin Int       @default(60)
  maxCapacity Int       @default(20)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch      Branch                 @relation(fields: [branchId], references: [id])
  trainers    CrossfitClassTrainer[]
  enrollments CrossfitEnrollment[]
  sessions    CrossfitSession[]

  @@index([branchId])
  @@map("crossfit_classes")
}

model CrossfitClassTrainer {
  id               String   @id @default(cuid())
  classId          String
  trainerProfileId String
  branchId         String
  createdAt        DateTime @default(now())

  class   CrossfitClass  @relation(fields: [classId], references: [id])
  trainer TrainerProfile @relation(fields: [trainerProfileId], references: [id])
  branch  Branch         @relation(fields: [branchId], references: [id])

  @@unique([classId, trainerProfileId])
  @@index([branchId])
  @@index([classId])
  @@index([trainerProfileId])
  @@map("crossfit_class_trainers")
}

model CrossfitEnrollment {
  id              String               @id @default(cuid())
  branchId        String
  classId         String?              // null = program-wide monthly enrollment
  clientProfileId String?              // null for EXTERNAL_ONLY
  clientType      KickboxingClientType // reuses GYM_MEMBER | EXTERNAL_ONLY
  externalName    String?
  externalPhone   String?
  isActive        Boolean              @default(true)
  enrolledAt      DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  branch  Branch             @relation(fields: [branchId], references: [id])
  class   CrossfitClass?     @relation(fields: [classId], references: [id])
  client  ClientProfile?     @relation(fields: [clientProfileId], references: [id])

  @@index([branchId])
  @@index([branchId, clientType])
  @@map("crossfit_enrollments")
}

model CrossfitSession {
  id        String                @id @default(cuid())
  branchId  String
  classId   String
  date      DateTime              // the specific date of this session occurrence
  status    CrossfitSessionStatus @default(SCHEDULED)
  startedAt DateTime?
  endedAt   DateTime?
  startedByUserId String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  branch      Branch               @relation(fields: [branchId], references: [id])
  class       CrossfitClass        @relation(fields: [classId], references: [id])
  attendances CrossfitAttendance[]

  @@unique([classId, date])
  @@index([branchId, date])
  @@index([branchId, status])
  @@map("crossfit_sessions")
}

model CrossfitAttendance {
  id              String   @id @default(cuid())
  branchId        String
  sessionId       String
  clientProfileId String?  // null for external/walk-in
  externalName    String?  // for non-enrolled walk-ins
  markedByUserId  String   // crossfit trainer's user id
  markedAt        DateTime @default(now())

  branch  Branch          @relation(fields: [branchId], references: [id])
  session CrossfitSession @relation(fields: [sessionId], references: [id])
  client  ClientProfile?  @relation(fields: [clientProfileId], references: [id])

  @@unique([sessionId, clientProfileId])
  @@index([branchId, sessionId])
  @@map("crossfit_attendances")
}

// ─── PAYMENTS ────────────────────────────────────────

model PaymentRecord {
  id              String        @id @default(cuid())
  branchId        String
  clientProfileId String
  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  periodStart     DateTime?
  periodEnd       DateTime?
  notes           String?
  recordedByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  branch Branch        @relation(fields: [branchId], references: [id])
  client ClientProfile @relation(fields: [clientProfileId], references: [id])

  @@index([branchId, clientProfileId])
  @@index([branchId, status])
  @@map("payment_records")
}

// ─── FCM TOKENS ──────────────────────────────────────

model FcmToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}

// ─── NOTIFICATIONS ───────────────────────────────────

model NotificationLog {
  id          String             @id @default(cuid())
  branchId    String
  recipientId String
  channel     NotificationChannel
  status      NotificationStatus @default(PENDING)
  title       String
  body        String
  metadata    Json?
  sentAt      DateTime?
  readAt      DateTime?
  failReason  String?
  createdAt   DateTime           @default(now())

  branch    Branch @relation(fields: [branchId], references: [id])
  recipient User   @relation("NotificationRecipient", fields: [recipientId], references: [id])

  @@index([branchId, recipientId])
  @@index([branchId, status])
  @@map("notification_logs")
}

// ─── BADGES ──────────────────────────────────────────

model BadgeDefinition {
  id             String       @id @default(cuid())
  type           BadgeType
  name           String
  description    String
  icon           String       // emoji fallback, e.g. "🔥" or "🏆"
  imageUrl       String?      // custom PNG badge image URL
  thresholdValue    Float?             // e.g. 30 (days streak), 100 (sessions), 5 (kg lost)
  thresholdUnit     ThresholdUnit?     // KG, REPS, or SECONDS (for EXERCISE_MILESTONE)
  durationCondition DurationCondition? // LONGER_IS_BETTER or SHORTER_IS_BETTER (when unit = SECONDS)
  genderFilter      GenderFilter       @default(ALL)
  exerciseId        String?            // FK to Exercise (for EXERCISE_MILESTONE / WEIGHT_LIFTED)
  howToEarn      String?      // user-facing instructions for earning the badge
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  exercise   Exercise?  @relation(fields: [exerciseId], references: [id])
  userBadges UserBadge[]

  @@index([type, isActive])
  @@map("badge_definitions")
}

model UserBadge {
  id                String   @id @default(cuid())
  branchId          String
  clientProfileId   String
  badgeDefinitionId String
  context           String   @default("") // "" for non-contextual; exerciseId for PR badges
  awardedAt         DateTime @default(now())
  displayOnProfile  Boolean  @default(true)
  seenByClient      Boolean  @default(false)
  metadata          Json?    // e.g. { exerciseName, weightKg } for PR badges

  branch          Branch          @relation(fields: [branchId], references: [id])
  client          ClientProfile   @relation(fields: [clientProfileId], references: [id])
  badgeDefinition BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id])

  @@unique([clientProfileId, badgeDefinitionId, context])
  @@index([branchId, clientProfileId])
  @@map("user_badges")
}

// ─── COMMUNITY ───────────────────────────────────────

model CommunityPost {
  id              String   @id @default(cuid())
  branchId        String
  clientProfileId String
  content         String?  // optional caption / message
  exerciseId      String?  // set for auto-generated PR posts
  weightKg        Float?   // PR weight (auto-generated)
  reps            Int?     // PR reps (auto-generated)
  isAutoGenerated Boolean  @default(false)
  isHidden        Boolean  @default(false) // soft-delete for trainer-removed auto-posts
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch    Branch            @relation(fields: [branchId], references: [id])
  client    ClientProfile     @relation(fields: [clientProfileId], references: [id])
  exercise  Exercise?         @relation(fields: [exerciseId], references: [id])
  reactions CommunityReaction[]
  comments  CommunityComment[]

  @@index([branchId, createdAt])
  @@index([branchId, clientProfileId])
  @@map("community_posts")
}

model CommunityReaction {
  id              String   @id @default(cuid())
  postId          String
  clientProfileId String
  createdAt       DateTime @default(now())

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  client ClientProfile @relation(fields: [clientProfileId], references: [id])

  @@unique([postId, clientProfileId])
  @@index([postId])
  @@map("community_reactions")
}

model CommunityComment {
  id              String   @id @default(cuid())
  postId          String
  clientProfileId String
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  client ClientProfile @relation(fields: [clientProfileId], references: [id])

  @@index([postId])
  @@map("community_comments")
}

// ─── AUDIT LOG ───────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  branchId    String
  actorId     String
  action      String
  subjectType String
  subjectId   String
  oldValue    Json?
  newValue    Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
  actor  User   @relation("AuditActor", fields: [actorId], references: [id])

  @@index([branchId, action])
  @@index([branchId, subjectType, subjectId])
  @@index([branchId, actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── TV DASHBOARD ────────────────────────────────────

/// A physical TV display registered against a branch. Each device has a
/// long-lived bearer token used to authenticate `/api/admin/tv/*` reads from
/// the unattended TV. Token is stored hashed; the plaintext is returned only
/// once on creation. Pair with a User row whose `roles` includes `TV_DISPLAY`
/// if you need session-based auth — most deployments will use the bearer.
model TvDevice {
  id          String    @id @default(cuid())
  branchId    String
  name        String    // human label, e.g. "Main Floor TV"
  tokenHash   String    @unique // bcrypt hash of the bearer token
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdByUserId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("tv_devices")
}

/// Singleton row per branch holding admin-driven overrides for the TV display
/// rotation. `pinnedPanels` restricts the rotation to a chosen subset of panels
/// (empty = auto-rotate everything; one entry = effectively frozen on that panel).
/// `shoutout` is a transient banner shown for `shoutoutExpiresAt - now` seconds.
model TvControlState {
  id                String   @id @default(cuid())
  branchId          String   @unique
  pinnedPanels      String[]
  shoutout          String?
  shoutoutExpiresAt DateTime?
  updatedByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("tv_control_state")
}

/// Multi-slide announcement deck shown as a panel in the TV rotation. Each
/// active, non-expired row becomes one slide. Admins manage these from
/// /admin/tv-control. Soft-active via `isActive`; cleared via expiry or delete.
model TvAnnouncement {
  id          String    @id @default(cuid())
  branchId    String
  title       String
  body        String
  icon        String?   // emoji or short label
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdByUserId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, isActive])
  @@map("tv_announcements")
}

/// Upcoming gym events (beach workouts, fun runs, charity WODs, etc.) shown
/// as a "Coming Up" board on the TV. Past events auto-hide via the eventAt
/// filter at query time. Managed from /admin/tv-control.
model TvEvent {
  id              String   @id @default(cuid())
  branchId        String
  title           String
  description     String?
  location        String?
  icon            String?  // emoji or short label
  eventAt         DateTime // when the event happens
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, isActive, eventAt])
  @@map("tv_events")
}
